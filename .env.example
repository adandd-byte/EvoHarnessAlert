AI_PROVIDER=mock
AGENT_FRAMEWORK=event_driven_multi_agent
AGENT_RUNTIME_MAX_STEPS=8
AGENT_RUNTIME_MAX_CLAIMS_PER_ROUND=4
AGENT_RUNTIME_MAX_CLAIMS_PER_AGENT=3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=evoharness-alert-qwen2.5-7b:latest
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=mysql+pymysql://evoalert:evoalert@127.0.0.1:13306/evoharness_alert?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_VECTOR_ENABLED=false
CHROMA_COLLECTION_NAME=evoharness_alert_knowledge
RAG_EVAL_DATASET=app/rag_eval/alert_eval_cases_zh.json
RAG_EVAL_OUTPUT=target/rag-eval-report.json
RAG_EVAL_MOCK_KNOWLEDGE=false
EXCEL_PATH=data/evoharness-alert-ledger.xlsx
TOOL_QUEUE_ENABLED=true
TOOL_QUEUE_EXCEL_WORKERS=1
TOOL_QUEUE_EMAIL_WORKERS=2
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[EvoHarnessAlert P0/P1告警]
